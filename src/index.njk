---
layout: base.njk
title: Silver & Elegant — Handcrafted Silver Jewellery
permalink: "/index.html"
---
  <!-- Hero -->
  <section class="hero" id="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-tagline reveal">{{ settings.tagline | default("Handcrafted Silver Jewellery") }}</div>
      <h1 class="hero-title reveal reveal-delay-1">Silver &amp; Elegant</h1>
      <p class="hero-sub reveal reveal-delay-2">Artistry in the making.</p>
      <a href="/collections/index.html" class="btn btn-outline reveal reveal-delay-3" id="hero-cta">Explore the Collection</a>
    </div>
    <div class="hero-scroll">
      <span>Scroll</span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- Featured Pieces -->
  <section class="section featured" id="featured">
    <div class="container">
      <div class="section-header reveal">
        <span class="label">Featured Work</span>
        <h2>Selected Pieces</h2>
      </div>
      <div class="pieces-grid" id="featured-grid">
        {% for piece in pieces.pieces %}
          {% if piece.featured %}
          <a href="/piece/{{ piece.id }}/index.html" class="piece-card reveal">
            <div class="piece-image">
              <img src="/{{ piece.images[0] | imgpath }}" alt="{{ piece.name }} frontend image" loading="lazy">
            </div>
            <div class="piece-card-content">
              <h3 class="piece-name">{{ piece.name }}</h3>
              <p class="piece-collection">{{ piece.collection | capitalize }}</p>
            </div>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      <div class="section-footer reveal">
        <a href="/collections/index.html" class="btn btn-text" id="view-all-link">View all pieces →</a>
      </div>
    </div>
  </section>

  <!-- The Craft -->
  <section class="craft-section" id="craft">
    <div class="craft-inner">
      <div class="craft-image reveal">
        <img src="/assets/about-workshop.png" alt="Silversmith at work in the workshop">
      </div>
      <div class="craft-content reveal reveal-delay-1">
        <span class="label">The Craft</span>
        <h2>Each piece is a record of its making.</h2>
        <p>Every mark left by the hammer is a decision. Silver remembers pressure, heat, and intention. The process is visible in the finished form — nothing is hidden, nothing is erased.</p>
        <a href="/about/index.html" class="btn btn-text-light" id="craft-about-link">About the maker →</a>
      </div>
    </div>
  </section>

  {% if settings.wolfandbadger or settings.more4id or settings.njal %}
  <div class="wb-strip" id="wb-strip" style="background: var(--c-cream); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); padding: 4.5rem 2rem; text-align: center;">
    <div style="max-width: 800px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem; align-items: center;">
      <span style="font-family: var(--font-sans); font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-muted);">Available On</span>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 2.2rem; align-items: center; font-family: var(--font-serif); font-size: clamp(1.2rem, 3.5vw, 1.8rem); line-height: 1.2;">
        {% if settings.wolfandbadger %}
          <a href="{{ settings.wolfandbadger }}" target="_blank" rel="noopener" style="color: var(--c-ink); text-decoration: none; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='1'">Wolf &amp; Badger</a>
        {% endif %}
        
        {% if settings.wolfandbadger and (settings.more4id or settings.njal) %}
          <span style="font-family: var(--font-sans); font-size: 0.8rem; color: var(--c-border);">/</span>
        {% endif %}

        {% if settings.more4id %}
          <a href="{{ settings.more4id }}" target="_blank" rel="noopener" style="color: var(--c-ink); text-decoration: none; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='1'">More4id</a>
        {% endif %}

        {% if settings.more4id and settings.njal %}
          <span style="font-family: var(--font-sans); font-size: 0.8rem; color: var(--c-border);">/</span>
        {% endif %}

        {% if settings.njal %}
          <a href="{{ settings.njal }}" target="_blank" rel="noopener" style="color: var(--c-ink); text-decoration: none; transition: opacity 0.3s;" onmouseover="this.style.opacity='0.6'" onmouseout="this.style.opacity='1'">Not Just A Label</a>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}

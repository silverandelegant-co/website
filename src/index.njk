---
layout: base.njk
title: Silver & Elegant — Wearable Art Jewellery
permalink: "/index.html"
---
  <!-- Hero -->
  <section class="hero" id="hero">
    <div class="hero-bg"></div>
    <div class="hero-content">
      <div class="hero-tagline reveal">{{ settings.tagline | default("Wearable Art Jewellery") }}</div>
      <h1 class="hero-title reveal reveal-delay-1">Silver &amp; Elegant</h1>
      <p class="hero-sub reveal reveal-delay-2">Artistry in the making.</p>
      <a href="/collections/index.html" class="btn btn-outline reveal reveal-delay-3" id="hero-cta">Explore the Collection</a>
    </div>
    <div class="hero-scroll">
      <span>Scroll</span>
      <div class="hero-scroll-line"></div>
    </div>
  </section>

  <!-- Featured Press / Recognition -->
  {% set featuredPressCount = 0 %}
  {% for article in press.articles %}
    {% if article.featured %}
      {% set featuredPressCount = featuredPressCount + 1 %}
    {% endif %}
  {% endfor %}

  {% if featuredPressCount > 0 %}
  <section class="section home-press" id="home-press" style="background: var(--c-surface); border-bottom: 1px solid var(--c-border); padding-top: 5rem; padding-bottom: 5rem;">
    <div class="container" style="max-width: 1100px; margin: 0 auto; padding: 0 1.5rem;">
      <div class="section-header reveal" style="margin-bottom: 3rem; text-align: center;">
        <span class="label">{{ settings.home_press_label | default("Recognition") }}</span>
        <h2>{{ settings.home_press_title | default("In the Press") }}</h2>
      </div>
      
      <div class="home-press-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem;">
        {% for article in press.articles %}
          {% if article.featured %}
          <article class="home-press-card reveal" style="display: flex; flex-direction: column; gap: 1.5rem;">
            {% if article.featured_image %}
            <a href="/press/{{ article.id }}/index.html" style="display: block; overflow: hidden; aspect-ratio: 16/10; border: 1px solid var(--c-border); background: var(--c-bg); transition: transform 0.3s var(--ease);">
              <img src="/{{ article.featured_image | imgpath }}" alt="{{ article.title }}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s var(--ease);" onmouseover="this.style.transform='scale(1.03)'" onmouseout="this.style.transform='scale(1)'">
            </a>
            {% endif %}
            <div style="display: flex; flex-direction: column; gap: 0.8rem; flex-grow: 1;">
              <div style="font-family: var(--font-sans); font-size: 0.65rem; font-weight: 500; letter-spacing: 0.1em; color: var(--c-muted); text-transform: uppercase;">
                {% if article.date %}
                  <time datetime="{{ article.date | dateIso }}">{{ article.date | postDate }}</time>
                {% endif %}
              </div>
              <h3 style="font-family: var(--font-serif); font-size: clamp(1.2rem, 2vw, 1.6rem); font-weight: 300; line-height: 1.3; margin: 0;">
                <a href="/press/{{ article.id }}/index.html" style="text-decoration: none; color: var(--c-ink); transition: opacity 0.3s var(--ease);" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">
                  {{ article.title }}
                </a>
              </h3>
              <p style="font-family: var(--font-serif); font-size: 0.95rem; line-height: 1.6; color: var(--c-muted); margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                {{ article.summary }}
              </p>
              <a href="/press/{{ article.id }}/index.html" class="btn btn-text" style="font-size: 0.75rem; letter-spacing: 0.05em; padding-left: 0; margin-top: auto; align-self: flex-start;">
                Read Feature &rarr;
              </a>
            </div>
          </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Featured Pieces -->
  <section class="section featured" id="featured">
    <div class="container">
      <div class="section-header reveal">
        <span class="label">{{ settings.home_pieces_label | default("Featured Work") }}</span>
        <h2>{{ settings.home_pieces_title | default("Selected Pieces") }}</h2>
      </div>
      <div class="pieces-grid" id="featured-grid">
        {% for piece in pieces.pieces %}
          {% if piece.featured %}
          <a href="/piece/{{ piece.id }}/index.html" class="piece-card reveal">
            <div class="piece-image">
              <img src="/{{ piece.images[0] | imgpath }}" alt="{{ piece.name }} frontend image" loading="lazy">
            </div>
            <div class="piece-card-content">
              <h3 class="piece-name">{{ piece.name }}</h3>
              <p class="piece-collection">{{ piece.collection | capitalize }}</p>
            </div>
          </a>
          {% endif %}
        {% endfor %}
      </div>
      <div class="section-footer reveal">
        <a href="/collections/index.html" class="btn btn-text" id="view-all-link">View all pieces →</a>
      </div>
    </div>
  </section>

  <!-- The Craft -->
  <section class="craft-section" id="craft">
    <div class="craft-inner">
      <div class="craft-image reveal">
        <img src="/assets/about-workshop.png" alt="Silversmith at work in the workshop">
      </div>
      <div class="craft-content reveal reveal-delay-1">
        <span class="label">The Craft</span>
        <h2>Each piece is a record of its making.</h2>
        <p>Every mark left by the hammer is a decision. Silver remembers pressure, heat, and intention. The process is visible in the finished form — nothing is hidden, nothing is erased.</p>
        <a href="/about/index.html" class="btn btn-text-light" id="craft-about-link">About the maker →</a>
      </div>
    </div>
  </section>

  {% if settings.wolfandbadger or settings.more4id or settings.njal %}
  <div class="wb-strip" id="wb-strip" style="background: var(--c-cream); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); padding: 5rem 2rem; text-align: center;">
    <div style="max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 2.5rem; align-items: center;">
      <span style="font-family: var(--font-sans); font-size: 0.68rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-muted);">Available On</span>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 4.5rem; align-items: stretch; width: 100%;">
        
        {% if settings.wolfandbadger %}
        <a href="{{ settings.wolfandbadger }}" target="_blank" rel="noopener" style="display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-decoration: none; color: var(--c-ink); opacity: 0.75; transition: all 0.3s var(--ease); max-width: 200px; flex: 1 1 180px;" onmouseover="this.style.opacity='1'; this.style.transform='translateY(-2px)'" onmouseout="this.style.opacity='0.75'; this.style.transform='translateY(0)'">
          <div style="height: 40px; display: flex; align-items: center; justify-content: center; width: 100%; color: var(--c-ink);">
            {% include "logos/wolf-and-badger.svg" %}
          </div>
          <span style="font-family: var(--font-sans); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-muted); margin-top: 0.8rem;">Official Store →</span>
        </a>
        {% endif %}

        {% if settings.more4id %}
        <a href="{{ settings.more4id }}" target="_blank" rel="noopener" style="display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-decoration: none; color: var(--c-ink); opacity: 0.75; transition: all 0.3s var(--ease); max-width: 200px; flex: 1 1 180px;" onmouseover="this.style.opacity='1'; this.style.transform='translateY(-2px)'" onmouseout="this.style.opacity='0.75'; this.style.transform='translateY(0)'">
          <div style="height: 40px; display: flex; align-items: center; justify-content: center; width: 100%; color: var(--c-ink);">
            {% include "logos/more4id.svg" %}
          </div>
          <span style="font-family: var(--font-sans); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-muted); margin-top: 0.8rem;">Official Store →</span>
        </a>
        {% endif %}

        {% if settings.njal %}
        <a href="{{ settings.njal }}" target="_blank" rel="noopener" style="display: flex; flex-direction: column; align-items: center; justify-content: space-between; text-decoration: none; color: var(--c-ink); opacity: 0.75; transition: all 0.3s var(--ease); max-width: 200px; flex: 1 1 180px;" onmouseover="this.style.opacity='1'; this.style.transform='translateY(-2px)'" onmouseout="this.style.opacity='0.75'; this.style.transform='translateY(0)'">
          <div style="height: 40px; display: flex; align-items: center; justify-content: center; width: 100%; color: var(--c-ink);">
            {% include "logos/njal.svg" %}
          </div>
          <span style="font-family: var(--font-sans); font-size: 0.6rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--c-muted); margin-top: 0.8rem;">Designer Profile →</span>
        </a>
        {% endif %}

      </div>
    </div>
  </div>
  {% endif %}

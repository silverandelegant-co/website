---
layout: base.njk
pagination:
  data: pieces.detailedPieces
  size: 1
  alias: piece
permalink: "piece/{{ piece.id }}/index.html"
eleventyComputed:
  title: "{{ piece.name }} — Silver & Elegant"
---

  <!-- Piece container -->
  <div id="piece-container">

    <!-- Hero Image Section -->
    {# Determine effective image list: drive_images take priority if any are set #}
    {% set effectiveImages = piece.drive_images if (piece.drive_images and piece.drive_images | length > 0 and piece.drive_images[0]) else piece.images %}
    {% set isDrive = (piece.drive_images and piece.drive_images | length > 0 and piece.drive_images[0]) %}

    <div style="padding-top: 5rem; background: var(--c-cream); display: flex; flex-direction: column; align-items: center; gap: 1.5rem;">
      <div style="width: 100%; max-width: 800px; margin: 0 auto; display: flex; justify-content: center; padding: 0 2rem; position: relative; min-height: 300px; align-items: center;">
        <div id="hero-loader" style="position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; pointer-events: none;">
          <div style="width: 36px; height: 36px; border: 2px solid var(--c-border); border-top-color: var(--c-ink); border-radius: 50%; animation: hero-spin 0.8s linear infinite;"></div>
        </div>
        <style>
          @keyframes hero-spin { to { transform: rotate(360deg); } }
        </style>
        {% if isDrive %}
          <img id="piece-hero-img" class="piece-hero-img" src="{{ effectiveImages[0] | driveimage }}" alt="{{ piece.name }}" style="max-height: 80vh; object-fit: contain; transition: opacity 0.35s ease; opacity: 0;" onload="this.style.opacity='1'; document.getElementById('hero-loader').style.display='none';">
        {% else %}
          <img id="piece-hero-img" class="piece-hero-img" src="/{{ effectiveImages[0] | imgpath }}" alt="{{ piece.name }}" style="max-height: 80vh; object-fit: contain; transition: opacity 0.35s ease; opacity: 0;" onload="this.style.opacity='1'; document.getElementById('hero-loader').style.display='none';">
        {% endif %}
      </div>
      
      {% if effectiveImages and effectiveImages.length > 1 %}
      <div style="width: 100%; max-width: 1200px; margin: 0 auto; padding: 0 2rem 2rem; display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;" id="piece-gallery-thumbnails">
        {% for img in effectiveImages %}
          <div style="width: 80px; height: 80px; cursor: pointer; border: 1px solid {% if loop.first %}var(--c-ink){% else %}var(--c-border){% endif %}; background: #fff; display: flex; align-items: center; justify-content: center; overflow: hidden; opacity: {% if loop.first %}1{% else %}0.6{% endif %}; transition: all 0.25s var(--ease);"
               class="piece-thumb"
               onclick="updateHeroImage(this, '{% if isDrive %}{{ img | driveimage }}{% else %}/{{ img | imgpath }}{% endif %}')">
            {% if isDrive %}
              <img src="{{ img | drivethumb(160) }}" alt="{{ piece.name }} view {{ loop.index }}" style="width: 100%; height: 100%; object-fit: cover;">
            {% else %}
              <img src="/{{ img | imgpath }}" alt="{{ piece.name }} view {{ loop.index }}" style="width: 100%; height: 100%; object-fit: cover;">
            {% endif %}
          </div>
        {% endfor %}
      </div>
      
      <script>
        function updateHeroImage(thumbElement, newSrc) {
          const hero = document.getElementById('piece-hero-img');
          const loader = document.getElementById('hero-loader');
          if (hero) {
            hero.style.opacity = '0';
            if (loader) loader.style.display = 'flex';
            
            const tempImg = new Image();
            tempImg.onload = function() {
              hero.src = newSrc;
              hero.style.opacity = '1';
              if (loader) loader.style.display = 'none';
            };
            tempImg.src = newSrc;
            if (tempImg.complete) {
              hero.src = newSrc;
              hero.style.opacity = '1';
              if (loader) loader.style.display = 'none';
            }
          }
          
          const thumbs = document.querySelectorAll('.piece-thumb');
          thumbs.forEach(thumb => {
            thumb.style.borderColor = 'var(--c-border)';
            thumb.style.opacity = '0.6';
          });
          
          thumbElement.style.borderColor = 'var(--c-ink)';
          thumbElement.style.opacity = '1';
        }
      </script>
      {% endif %}
    </div>

    <!-- Breadcrumb -->
    <div style="border-bottom:1px solid var(--c-border); padding: 1rem 2rem;">
      <div style="max-width:1200px; margin:0 auto;">
        <nav aria-label="Breadcrumb" style="font-family:var(--font-sans);font-size:0.68rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--c-muted);">
          <a href="/collections/" style="color:var(--c-muted);">Collections</a>
          <span style="margin:0 0.6rem;">—</span>
          <span id="piece-collection" style="color:var(--c-ink);">{{ piece.collection | capitalize }}</span>
        </nav>
      </div>
    </div>

    <!-- Piece Layout -->
    <div class="piece-layout">

      <!-- Sidebar -->
      <aside class="piece-sidebar">
        <div class="piece-meta">
          <h1 id="piece-name">{{ piece.name }}</h1>
          <div class="piece-divider"></div>
          <div>
            <p class="piece-materials-label">Materials</p>
            <ul class="piece-materials-list" id="piece-materials">
              {% for material in piece.materials %}
                <li>{{ material }}</li>
              {% endfor %}
            </ul>
          </div>
        </div>
        <div class="piece-actions">
          <div class="piece-divider"></div>
          <div style="display:flex;flex-direction:column;gap:0.8rem;">
            {% if piece.wolfandbadger and piece.wolfandbadger != "https://www.wolfandbadger.com/" %}
              <a href="{{ piece.wolfandbadger }}" id="piece-wb-link" target="_blank" rel="noopener" class="btn btn-dark" style="text-align:center; line-height:1.5; padding:0.8rem 1.5rem;">Available on<br>Wolf &amp; Badger</a>
            {% endif %}
            {% if piece.more4id and piece.more4id != "https://www.more4id.com/" %}
              <a href="{{ piece.more4id }}" id="piece-more4id-link" target="_blank" rel="noopener" class="btn btn-dark" style="text-align:center; line-height:1.5; padding:0.8rem 1.5rem;">Available on<br>More4id</a>
            {% endif %}
            {% if piece.njal and piece.njal != "https://notjustalabel.com/" %}
              <a href="{{ piece.njal }}" id="piece-njal-link" target="_blank" rel="noopener" class="btn btn-dark" style="text-align:center; line-height:1.5; padding:0.8rem 1.5rem;">Available on<br>Not Just A Label</a>
            {% endif %}
            <a href="/contact/index.html" class="btn btn-outline-dark" style="text-align:center;">Private Enquiry</a>
          </div>
          <div class="piece-divider"></div>
          <a href="/collections/index.html" class="btn btn-text" style="font-size:0.68rem;">← Back to all pieces</a>
        </div>
      </aside>

      <!-- Story -->
      <article class="piece-story" id="piece-story" style="white-space: pre-line;">{{ piece.story }}</article>

    </div>

    {% if piece.video_url and piece.video_url | youtubeEmbed %}
    <div style="border-top:1px solid var(--c-border); padding: 5rem 2rem; background: var(--c-cream);">
      <div style="max-width:800px; margin:0 auto; display:flex; flex-direction:column; gap:2rem;">
        <span style="font-family:var(--font-sans); font-size:0.68rem; letter-spacing:0.12em; text-transform:uppercase; color:var(--c-muted); text-align:center;">Narrative Video</span>
        <div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; max-width:100%; border:1px solid var(--c-border); background:#000;">
          <iframe 
            src="{{ piece.video_url | youtubeEmbed }}" 
            style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;" 
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
      </div>
    </div>
    {% endif %}

    <!-- Other Pieces / Explore More Section -->
    <div style="border-top:1px solid var(--c-border); padding: 6rem 2rem; background: var(--c-bg);" id="other-pieces-section" class="reveal">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div class="section-header center" style="margin-bottom: 4rem; text-align: center; display: flex; flex-direction: column; gap: 0.75rem;">
          <span class="label">Explore More</span>
          <h2 style="font-family: var(--font-serif); font-size: 2.2rem; font-weight: 300;">Other Creations</h2>
        </div>
        
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 2rem;">
          {# Loop over other pieces, excluding the current one #}
          {% set count = 0 %}
          {% for other_piece in pieces.pieces %}
            {% if other_piece.id != piece.id and count < 4 %}
              {% set count = count + 1 %}
              {% if other_piece.no_detail %}
                <!-- Simple Piece -->
                <div class="piece-card reveal simple-piece-card" style="cursor: pointer;"
                  onclick="openImageLightbox(this, '{% if other_piece.drive_images and other_piece.drive_images | length > 0 and other_piece.drive_images[0] %}{{ other_piece.drive_images[0] | driveimage }}{% else %}/{{ other_piece.images[0] | imgpath }}{% endif %}')">
                  <div class="piece-image" style="aspect-ratio: 3/4; overflow: hidden; background: var(--c-cream);">
                    {% if other_piece.drive_images and other_piece.drive_images | length > 0 and other_piece.drive_images[0] %}
                      <img src="{{ other_piece.drive_images[0] | drivethumb(600) }}" alt="{{ other_piece.collection | capitalize }} piece image" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(8%); transition: transform 600ms var(--ease), filter 300ms;">
                    {% else %}
                      <img src="/{{ other_piece.images[0] | imgpath }}" alt="{{ other_piece.collection | capitalize }} piece image" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(8%); transition: transform 600ms var(--ease), filter 300ms;">
                    {% endif %}
                  </div>
                </div>
              {% else %}
                <!-- Detailed Piece -->
                <a href="/piece/{{ other_piece.id }}/index.html" class="piece-card reveal">
                  <div class="piece-image" style="aspect-ratio: 3/4; overflow: hidden; background: var(--c-cream);">
                    {% if other_piece.drive_images and other_piece.drive_images | length > 0 and other_piece.drive_images[0] %}
                      <img src="{{ other_piece.drive_images[0] | drivethumb(600) }}" alt="{{ other_piece.name }} frontend image" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(8%); transition: transform 600ms var(--ease), filter 300ms;">
                    {% else %}
                      <img src="/{{ other_piece.images[0] | imgpath }}" alt="{{ other_piece.name }} frontend image" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; filter: grayscale(8%); transition: transform 600ms var(--ease), filter 300ms;">
                    {% endif %}
                  </div>
                  <div class="piece-card-content" style="padding: 1.4rem 1.2rem 1.6rem;">
                    <h3 class="piece-name" style="font-family: var(--font-serif); font-size: 1.8rem; font-weight: 400; line-height: 1; margin-bottom: 0.5rem; color: var(--c-ink);">{{ other_piece.name }}</h3>
                    <p class="piece-collection" style="display: block; font-family: var(--font-sans); font-size: 0.65rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--c-silver); margin-bottom: 0.4rem;">{{ other_piece.collection | capitalize }}</p>
                  </div>
                </a>
              {% endif %}
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>

  </div>

<!DOCTYPE html>
<html lang="en-GB">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="refresh" content="0; url=/">
  <title>Redirecting... — Silver & Elegant</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=DM+Sans:wght@300;400&display=swap" rel="stylesheet">
  <style>
    :root {
      --c-bg: #faf8f5;
      --c-ink: #1c1917;
      --c-muted: #78716c;
      --font-serif: 'Cormorant Garamond', 'Times New Roman', serif;
      --font-sans: 'DM Sans', sans-serif;
    }
    
    body, html {
      margin: 0;
      padding: 0;
      width: 100%;
      height: 100%;
      background-color: var(--c-bg);
      color: var(--c-ink);
      font-family: var(--font-sans);
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      -webkit-font-smoothing: antialiased;
    }
    
    .container {
      max-width: 400px;
      padding: 20px;
      animation: fadeIn 0.8s ease-out forwards;
    }
    
    .logo {
      font-family: var(--font-serif);
      font-size: 2.2rem;
      font-weight: 300;
      letter-spacing: 0.15em;
      margin-bottom: 0.5rem;
      text-transform: uppercase;
      opacity: 0.9;
    }
    
    .tagline {
      font-family: var(--font-serif);
      font-style: italic;
      font-size: 1.1rem;
      color: var(--c-muted);
      margin-bottom: 2rem;
    }
    
    .message {
      font-size: 0.9rem;
      letter-spacing: 0.05em;
      color: var(--c-muted);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }
    
    .spinner {
      width: 20px;
      height: 20px;
      border: 1px solid rgba(28, 25, 23, 0.1);
      border-top-color: var(--c-ink);
      border-radius: 50%;
      animation: spin 0.8s linear infinite;
    }
    
    .fallback-link {
      color: var(--c-ink);
      text-decoration: none;
      border-bottom: 1px solid var(--c-ink);
      padding-bottom: 1px;
      transition: opacity 0.2s;
    }
    
    .fallback-link:hover {
      opacity: 0.6;
    }
    
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
    
    @keyframes spin {
      to { transform: rotate(360deg); }
    }
  </style>
  <script>
    // Instantly redirect using location.replace to avoid clogging browser history
    window.location.replace("/");
  </script>
</head>
<body>
  <div class="container">
    <div class="logo">Silver &amp; Elegant</div>
    <div class="tagline">Artistry in the making.</div>
    <div class="message">
      <div class="spinner"></div>
      <span>Redirecting you to the home page...</span>
      <span style="font-size: 0.8rem; margin-top: 10px;">
        If you are not redirected, <a href="/" class="fallback-link">click here</a>.
      </span>
    </div>
  </div>
</body>
</html>

<!-- SINGLE FILE OBJECTS (DIRECT FIELD EDITING SCREEN) -->
<template x-if="getActiveCatalogType() === 'single_object'">
  <div class="space-y-6 bg-slate-900/20 border border-slate-800 p-6 rounded-2xl relative">
    <div class="flex items-center justify-between border-b border-slate-800/80 pb-4">
      <div>
        <h3 class="font-serif text-2xl font-semibold text-slate-100" x-text="activeCatalogLabel"></h3>
        <p class="text-xs text-slate-500 mt-1">Bu sabit sayfaya ait metin ve ayarları doğrudan düzenleyin.</p>
      </div>
      <button @click="saveSingleObject()" 
        class="px-5 py-2.5 bg-gold-500 hover:bg-gold-400 active:scale-95 border border-transparent rounded-xl text-slate-950 text-xs font-semibold tracking-wide transition-all flex items-center space-x-2">
        <i class="fa-solid fa-floppy-disk"></i>
        <span>Sayfayı Kaydet</span>
      </button>
    </div>

    <div class="space-y-6 pt-4">
      <!-- GENERAL SETTINGS fields -->
      <div x-show="activeCatalog === 'settings'" class="space-y-5">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Instagram Adresi</label>
            <input type="text" x-model="singleObjectData.instagram" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" />
          </div>
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">E-posta Adresi</label>
            <input type="text" x-model="singleObjectData.email" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" />
          </div>
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Wolf & Badger Adresi</label>
            <input type="text" x-model="singleObjectData.wolfandbadger" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" />
          </div>
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">More4id Adresi</label>
            <input type="text" x-model="singleObjectData.more4id" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" />
          </div>
        </div>
        <div class="space-y-1.5">
          <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Not Just A Label Adresi</label>
          <input type="text" x-model="singleObjectData.njal" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" />
        </div>
        <div class="space-y-1.5">
          <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Ana Sayfa Tanıtım Yazısı (Tagline)</label>
          <input type="text" x-model="singleObjectData.tagline" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none focus:ring-1 focus:ring-gold-500 focus:border-gold-500" />
        </div>

        <!-- Homepage Section Titles Customization -->
        <div class="border-t border-slate-800/80 pt-5 space-y-4">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 font-sans">Ana Sayfa Bölüm Başlıkları</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Basın Bölümü Küçük Etiketi (Örn: Recognition)</label>
              <input type="text" x-model="singleObjectData.home_press_label" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Basın Bölümü Ana Başlığı (Örn: In the Press)</label>
              <input type="text" x-model="singleObjectData.home_press_title" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Ürünler Bölümü Küçük Etiketi (Örn: Featured Work)</label>
              <input type="text" x-model="singleObjectData.home_pieces_label" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Ürünler Bölümü Ana Başlığı (Örn: Selected Pieces)</label>
              <input type="text" x-model="singleObjectData.home_pieces_title" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
          </div>
        </div>

        <!-- Navigation Menu Customization -->
        <div class="border-t border-slate-800/80 pt-5 space-y-4">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 font-sans">Navigasyon Menü Linkleri (Menu Labels)</h4>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Collections Linki</label>
              <input type="text" x-model="singleObjectData.menu_collections" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Maker / Artisan Linki</label>
              <input type="text" x-model="singleObjectData.menu_artisan" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">About Linki</label>
              <input type="text" x-model="singleObjectData.menu_about" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Press Linki</label>
              <input type="text" x-model="singleObjectData.menu_press" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Blog Linki</label>
              <input type="text" x-model="singleObjectData.menu_blog" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Contact Linki</label>
              <input type="text" x-model="singleObjectData.menu_contact" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
          </div>
        </div>

        <!-- Collections & Blog Landing Pages SEO -->
        <div class="border-t border-slate-800/80 pt-5 space-y-4">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300 font-sans">Koleksiyon & Blog Sayfa Başlıkları (SEO)</h4>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Collections Sayfa Başlığı</label>
              <input type="text" x-model="singleObjectData.title_collections" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Collections Açıklaması (Meta Description)</label>
              <input type="text" x-model="singleObjectData.desc_collections" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Blog Sayfa Başlığı</label>
              <input type="text" x-model="singleObjectData.title_blog" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
            <div class="space-y-1.5">
              <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Blog Açıklaması (Meta Description)</label>
              <input type="text" x-model="singleObjectData.desc_blog" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-2 px-3 text-xs text-slate-200 focus:outline-none" />
            </div>
          </div>
        </div>
      </div>

      <!-- CONTACT fields -->
      <div x-show="activeCatalog === 'contact'" class="space-y-5">
        <!-- Contact Page SEO -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-4 border-b border-slate-800/85">
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 font-sans">Sayfa Başlığı (Browser Title)</label>
            <input type="text" x-model="singleObjectData.page_title" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none" />
          </div>
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 font-sans">Meta Açıklaması (Description)</label>
            <input type="text" x-model="singleObjectData.meta_description" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none" />
          </div>
        </div>
        
        <div class="space-y-1.5">
          <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400">Ana Başlık</label>
          <input type="text" x-model="singleObjectData.heading" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none" />
        </div>
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 font-sans">Giriş Metni</label>
            <button type="button"
              @click="openFullscreenEditor(
                'İletişim Giriş Metni',
                'Sayfa giriş yazısını tam ekran modunda düzenleyin.',
                singleObjectData.intro,
                (val) => { singleObjectData.intro = val; }
              )"
              class="px-2.5 py-1 bg-slate-950 border border-slate-800 text-gold-400 hover:text-gold-300 text-[10px] font-semibold rounded-lg flex items-center space-x-1.5 transition-all">
              <i class="fa-solid fa-expand"></i>
              <span>Tam Ekran Yap</span>
            </button>
          </div>
          <!-- WYSIWYG rich text editor with Turndown conversion -->
          <div 
            class="quill-wysiwyg-wrapper"
            x-init="
              const watch = $watch;
              $nextTick(() => {
                const container = $el.querySelector('.quill-editor');
                const quill = new Quill(container, {
                  theme: 'snow',
                  modules: {
                    toolbar: [
                      ['bold', 'italic', 'underline'],
                      [{ 'header': [1, 2, 3, false] }],
                      [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                      ['link', 'image', 'clean']
                    ]
                  }
                });
                
                // Register custom gallery image insertion handler (no this. prefix inside scope)
                quill.getModule('toolbar').addHandler('image', () => {
                  openMediaLibraryModal('quill', quill);
                });
                
                quill.root.innerHTML = marked.parse(singleObjectData.intro || '');
                const turndownService = new TurndownService({ headingStyle: 'atx' });
                quill.on('text-change', (delta, oldDelta, source) => {
                  if (source === 'user') {
                    singleObjectData.intro = turndownService.turndown(quill.root.innerHTML);
                  }
                });
                watch('singleObjectData.intro', (newVal) => {
                  const currentMarkdown = turndownService.turndown(quill.root.innerHTML);
                  if (newVal !== currentMarkdown) {
                    quill.root.innerHTML = marked.parse(newVal || '');
                  }
                });
              });
            "
          >
            <div class="quill-editor" style="height: 350px;"></div>
          </div>
        </div>
      </div>

      <!-- ABOUT (Hakkımızda) page -->
      <div x-show="activeCatalog === 'about'" class="space-y-6">
        <!-- About Page SEO -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-4 border-b border-slate-800/85">
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 font-sans">Sayfa Başlığı (Browser Title)</label>
            <input type="text" x-model="singleObjectData.page_title" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none" />
          </div>
          <div class="space-y-1.5">
            <label class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 font-sans">Meta Açıklaması (Description)</label>
            <input type="text" x-model="singleObjectData.meta_description" class="block w-full bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs text-slate-200 focus:outline-none" />
          </div>
        </div>

        <!-- Hero Image selection -->
        <div class="space-y-2">
          <label class="block text-xs font-semibold uppercase tracking-wider text-slate-400 font-sans">Giriş (Hero) Görseli</label>
          <div class="flex items-center space-x-3">
            <input type="text" x-model="singleObjectData.hero_image" class="block flex-grow bg-slate-950/60 border border-slate-800 rounded-xl py-3 px-4 text-xs font-mono text-slate-300 focus:outline-none" readonly />
            <button @click="openMediaLibraryModal(singleObjectData, 'hero_image')"
              class="px-4 py-3 bg-slate-900 border border-slate-800 hover:border-gold-500/20 text-gold-400 text-xs font-semibold rounded-xl flex-shrink-0">
              Görsel Seç
            </button>
          </div>
          <!-- Image preview -->
          <div class="mt-2 w-32 h-20 bg-slate-950 rounded-lg overflow-hidden border border-slate-800">
            <img :src="'/' + (singleObjectData.hero_image || '').replace(/^\/+/, '')" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/200x100/1e293b/a88653?text=Yok'" />
          </div>
        </div>

        <!-- Sections list editing -->
        <div class="space-y-3 pt-4 border-t border-slate-800/80">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300">Bölümler (Sections)</h4>
          <div class="space-y-3">
            <template x-for="(sec, idx) in singleObjectData.sections" :key="idx">
              <div class="bg-slate-950/40 border border-slate-800/80 p-4 rounded-xl space-y-3 relative">
                <button @click="singleObjectData.sections.splice(idx, 1)" class="absolute top-4 right-4 text-slate-500 hover:text-red-400 text-xs">
                  <i class="fa-solid fa-trash"></i>
                </button>
                <div class="grid grid-cols-2 gap-4 pr-8">
                  <div class="space-y-1">
                    <label class="text-[9px] uppercase tracking-wider text-slate-500">Etiket</label>
                    <input type="text" x-model="sec.label" class="block w-full bg-slate-900 border border-slate-800 rounded-lg py-1.5 px-3 text-xs text-slate-300" />
                  </div>
                  <div class="space-y-1">
                    <label class="text-[9px] uppercase tracking-wider text-slate-500">Başlık</label>
                    <input type="text" x-model="sec.title" class="block w-full bg-slate-900 border border-slate-800 rounded-lg py-1.5 px-3 text-xs text-slate-300" />
                  </div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="text-[9px] uppercase tracking-wider text-slate-500 font-sans">Metin İçeriği</label>
                    <button type="button"
                      @click="openFullscreenEditor(
                        sec.title || 'Bölüm Metni',
                        'Hakkımızda sayfası bölüm metnini düzenleyin.',
                        sec.body,
                        (val) => { sec.body = val; }
                      )"
                      class="px-2 py-0.5 bg-slate-900 border border-slate-800 text-gold-400 hover:text-gold-300 text-[9px] font-semibold rounded flex items-center space-x-1 transition-all">
                      <i class="fa-solid fa-expand"></i>
                      <span>Tam Ekran Yap</span>
                    </button>
                  </div>
                  
                  <!-- WYSIWYG section body editor -->
                  <div 
                    class="quill-wysiwyg-wrapper"
                    x-init="
                      const watch = $watch;
                      $nextTick(() => {
                        const container = $el.querySelector('.quill-editor');
                        const quill = new Quill(container, {
                          theme: 'snow',
                          modules: {
                            toolbar: [
                              ['bold', 'italic', 'underline'],
                              [{ 'list': 'ordered'}, { 'list': 'bullet' }],
                              ['link', 'image', 'clean']
                            ]
                          }
                        });
                        
                        // Register custom gallery image insertion handler (no this. prefix inside scope)
                        quill.getModule('toolbar').addHandler('image', () => {
                          openMediaLibraryModal('quill', quill);
                        });
                        
                        quill.root.innerHTML = marked.parse(sec.body || '');
                        const turndownService = new TurndownService({ headingStyle: 'atx' });
                        quill.on('text-change', (delta, oldDelta, source) => {
                          if (source === 'user') {
                            sec.body = turndownService.turndown(quill.root.innerHTML);
                          }
                        });
                        watch('sec.body', (newVal) => {
                          const currentMarkdown = turndownService.turndown(quill.root.innerHTML);
                          if (newVal !== currentMarkdown) {
                            quill.root.innerHTML = marked.parse(newVal || '');
                          }
                        });
                      });
                    "
                  >
                    <div class="quill-editor" style="height: 250px;"></div>
                  </div>
                </div>
              </div>
            </template>
          </div>
          <button @click="singleObjectData.sections.push({ label: '', title: '', body: '' })"
            class="px-3.5 py-2 bg-slate-950 hover:bg-slate-800 border border-slate-800 text-gold-400 text-xs font-semibold rounded-xl flex items-center space-x-1.5">
            <i class="fa-solid fa-plus text-[9px]"></i>
            <span>Yeni Bölüm Ekle</span>
          </button>
        </div>

        <!-- Process Steps list editing -->
        <div class="space-y-3 pt-4 border-t border-slate-800/80">
          <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-300">Süreç Adımları (Process Steps)</h4>
          <div class="space-y-3">
            <template x-for="(step, idx) in singleObjectData.process_steps" :key="idx">
              <div class="bg-slate-950/40 border border-slate-800/80 p-4 rounded-xl space-y-3 relative">
                <button @click="singleObjectData.process_steps.splice(idx, 1)" class="absolute top-4 right-4 text-slate-500 hover:text-red-400 text-xs">
                  <i class="fa-solid fa-trash"></i>
                </button>
                <div class="grid grid-cols-3 gap-4 pr-8">
                  <div class="space-y-1">
                    <label class="text-[9px] uppercase tracking-wider text-slate-500">Numara</label>
                    <input type="text" x-model="step.num" class="block w-full bg-slate-900 border border-slate-800 rounded-lg py-1.5 px-3 text-xs text-slate-300" />
                  </div>
                  <div class="space-y-1 col-span-2">
                    <label class="text-[9px] uppercase tracking-wider text-slate-500">Başlık</label>
                    <input type="text" x-model="step.title" class="block w-full bg-slate-900 border border-slate-800 rounded-lg py-1.5 px-3 text-xs text-slate-300" />
                  </div>
                </div>
                <div class="space-y-2">
                  <div class="flex items-center justify-between">
                    <label class="text-[9px] uppercase tracking-wider text-slate-500 font-sans">Açıklama</label>
                    <button type="button"
                      @click="openFullscreenEditor(
                        step.title || 'Adım Açıklaması',
                        'Süreç adımı açıklamasını düzenleyin.',
                        step.description,
                        (val) => { step.description = val; }
                      )"
                      class="px-2 py-0.5 bg-slate-900 border border-slate-800 text-gold-400 hover:text-gold-300 text-[9px] font-semibold rounded flex items-center space-x-1 transition-all">
                      <i class="fa-solid fa-expand"></i>
                      <span>Tam Ekran Yap</span>
                    </button>
                  </div>

                  <!-- WYSIWYG step description editor -->
                  <div 
                    class="quill-wysiwyg-wrapper"
                    x-init="
                      const watch = $watch;
                      $nextTick(() => {
                        const container = $el.querySelector('.quill-editor');
                        const quill = new Quill(container, {
                          theme: 'snow',
                          modules: {
                            toolbar: [
                              ['bold', 'italic', 'underline'],
                              ['link', 'image', 'clean']
                            ]
                          }
                        });
                        
                        // Register custom gallery image insertion handler (no this. prefix inside scope)
                        quill.getModule('toolbar').addHandler('image', () => {
                          openMediaLibraryModal('quill', quill);
                        });
                        
                        quill.root.innerHTML = marked.parse(step.description || '');
                        const turndownService = new TurndownService({ headingStyle: 'atx' });
                        quill.on('text-change', (delta, oldDelta, source) => {
                          if (source === 'user') {
                            step.description = turndownService.turndown(quill.root.innerHTML);
                          }
                        });
                        watch('step.description', (newVal) => {
                          const currentMarkdown = turndownService.turndown(quill.root.innerHTML);
                          if (newVal !== currentMarkdown) {
                            quill.root.innerHTML = marked.parse(newVal || '');
                          }
                        });
                      });
                    "
                  >
                    <div class="quill-editor" style="height: 200px;"></div>
                  </div>
                </div>
              </div>
            </template>

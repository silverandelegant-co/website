      // Getters for Grouping Dashboard & Sidebar
      get pagesCatalogs() {
        return this.catalogs.filter(c => c.type === 'single_object' || c.name === 'press');
      },
      get piecesCatalogs() {
        return this.catalogs.filter(c => c.type === 'pieces_list');
      },
      get blogCatalogs() {
        return this.catalogs.filter(c => c.type === 'posts_list');
      },
      
      activeCatalog: 'dashboard',
      searchQuery: '',
      
      globalLoading: false,
      loadingText: 'Yükleniyor...',
      
      // Single Object States (Direct forms)
      singleObjectData: {},
      pressHeading: '', // special handler for press heading
      pressPageTitle: '',
      pressMetaDescription: '',
      
      // Editor Panel States
      isEditing: false,
      isNew: false,
      editingItem: {},
      editingIndex: -1,
      errors: { id: null },
      
      // Media Library States
      mediaLibraryOpen: false,
      mediaLoading: false,
      mediaFiles: [],
      mediaSearchQuery: '',
      activeSelectedImage: '',
      activeSelectedImages: [],
      pendingImageUploads: [],
      pendingImageDeletes: [],
      mediaTargetObject: null,
      mediaTargetProperty: null,
      mediaTargetIndex: -1,
      
      // Global Fullscreen Editor States
      fullscreenEditorOpen: false,
      fullscreenEditorTitle: '',
      fullscreenEditorSubtitle: '',
      fullscreenEditorContent: '',
      fullscreenEditorCallback: null,
      
      allSlugs: [],

      initApp() {
        const savedToken = localStorage.getItem('admin_pat');
        if (savedToken) {
          this.token = savedToken;
          this.tokenInput = savedToken;
          this.isAuthenticated = true;
          this.loadAllCatalogs();
          this.loadMediaLibrary();
        }
      },

      async authenticate() {
        if (!this.tokenInput.trim()) {
          this.showToast('Lütfen geçerli bir GitHub Token (PAT) girin.', 'error');
          return;
        }
        this.showLoading('Token doğrulanıyor...');
        try {
          const res = await fetch(`https://api.github.com/repos/${this.repoOwner}/${this.repoName}`, {
            headers: { 'Authorization': `token ${this.tokenInput.trim()}` }
          });
          if (res.ok) {
            this.token = this.tokenInput.trim();
            localStorage.setItem('admin_pat', this.token);
            this.isAuthenticated = true;
            this.showToast('Giriş başarılı.', 'success');
            await this.loadAllCatalogs();
            await this.loadMediaLibrary();
          } else {
            throw new Error();
          }
        } catch (err) {
          this.showToast('Giriş başarısız. Token bilgilerinizi kontrol edin.', 'error');
        } finally {
          this.hideLoading();
        }
      },

      logout() {
        localStorage.removeItem('admin_pat');
        this.token = '';
        this.tokenInput = '';
        this.isAuthenticated = false;
        this.activeCatalog = 'dashboard';
      },

      showLoading(text = 'Yükleniyor...') {
        this.loadingText = text;
        this.globalLoading = true;
      },

      hideLoading() {
        this.globalLoading = false;
      },

      get activeCatalogLabel() {
        if (this.activeCatalog === 'dashboard') return 'Genel Bakış';
        const cat = this.catalogs.find(c => c.name === this.activeCatalog);
        return cat ? cat.label : '';
      },

      getActiveCatalogType() {
        const cat = this.catalogs.find(c => c.name === this.activeCatalog);
        return cat ? cat.type : '';
      },

      selectCatalog(name) {
        this.activeCatalog = name;
        this.searchQuery = '';
        
        const cat = this.catalogs.find(c => c.name === name);
        if (cat) {
          if (cat.type === 'single_object') {
            this.singleObjectData = JSON.parse(JSON.stringify(cat.data));
          } else if (name === 'press') {
            // Press has list and heading
            this.pressHeading = cat.heading || '';
            this.pressPageTitle = cat.page_title || '';
            this.pressMetaDescription = cat.meta_description || '';
          }
        }
      },

      getActiveCatalogData() {
        const cat = this.catalogs.find(c => c.name === this.activeCatalog);
        return cat ? cat.data : [];
      },

      filteredItems() {
        const items = this.getActiveCatalogData();
        if (!this.searchQuery.trim()) return items;
        
        const q = this.searchQuery.trim().toLowerCase();
        return items.filter(item => 
          (item.name && item.name.toLowerCase().includes(q)) || 
          (item.title && item.title.toLowerCase().includes(q)) ||
          (item.id && item.id.toLowerCase().includes(q))
        );
      },

      getItemImage(item) {
        if (item.images && item.images.length > 0) return '/' + item.images[0].replace(/^\/+/, '');
        if (item.featured_image) return '/' + item.featured_image.replace(/^\/+/, '');
        return 'https://placehold.co/100x100/1e293b/a88653?text=Görsel+Yok';
      },


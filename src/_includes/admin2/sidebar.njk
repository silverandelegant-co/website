<!-- SIDE NAVIGATION -->
<aside class="lg:w-64 flex-shrink-0">
  <nav class="space-y-1.5 sticky top-28">
    <button @click="activeCatalog = 'dashboard'" 
      class="w-full flex items-center space-x-3 px-4 py-3 rounded-xl text-sm font-medium transition-all group"
      :class="activeCatalog === 'dashboard' ? 'bg-gold-500/10 text-gold-300 border border-gold-500/20' : 'text-slate-400 hover:bg-slate-900/50 hover:text-slate-200 border border-transparent'">
      <i class="fa-solid fa-chart-line text-base" :class="activeCatalog === 'dashboard' ? 'text-gold-400' : 'text-slate-500'"></i>
      <span>Genel Bakış</span>
    </button>
    
    <!-- Group 1: Pages & System Settings (Includes Press) -->
    <div class="pt-4 pb-1.5 px-4">
      <span class="text-[10px] text-slate-600 font-semibold uppercase tracking-widest">Ayarlar & Sayfalar</span>
    </div>
    
    <template x-for="cat in pagesCatalogs" :key="cat.name">
      <button @click="selectCatalog(cat.name)" 
        class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium transition-all group"
        :class="activeCatalog === cat.name ? 'bg-gold-500/10 text-gold-300 border border-gold-500/20' : 'text-slate-400 hover:bg-slate-900/50 hover:text-slate-200 border border-transparent'">
        <div class="flex items-center space-x-3">
          <i class="fa-solid text-sm" :class="[
            cat.name === 'settings' ? 'fa-sliders' : '',
            cat.name === 'contact' ? 'fa-envelope-open-text' : '',
            cat.name === 'about' ? 'fa-circle-info' : '',
            cat.name === 'press' ? 'fa-newspaper' : '',
            activeCatalog === cat.name ? 'text-gold-400' : 'text-slate-500'
          ]"></i>
          <span x-text="cat.label"></span>
          <span x-show="cat.dirty" class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse" title="Yayınlanmamış değişiklikler var" x-cloak></span>
        </div>
        <span x-show="cat.name === 'press'" class="px-2 py-0.5 text-[10px] bg-slate-950 border border-slate-800 rounded-full text-slate-400" x-text="cat.data.length"></span>
      </button>
    </template>

    <!-- Group 2: Jewelry Collections -->
    <div class="pt-4 pb-1.5 px-4">
      <span class="text-[10px] text-slate-600 font-semibold uppercase tracking-widest">Takı Katalogları</span>
    </div>

    <template x-for="cat in piecesCatalogs" :key="cat.name">
      <button @click="selectCatalog(cat.name)" 
        class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium transition-all group"
        :class="activeCatalog === cat.name ? 'bg-gold-500/10 text-gold-300 border border-gold-500/20' : 'text-slate-400 hover:bg-slate-900/50 hover:text-slate-200 border border-transparent'">
        <div class="flex items-center space-x-3">
          <i class="fa-solid fa-gem text-sm" :class="activeCatalog === cat.name ? 'text-gold-400' : 'text-slate-500'"></i>
          <span x-text="cat.label"></span>
          <span x-show="cat.dirty" class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse" title="Yayınlanmamış değişiklikler var" x-cloak></span>
        </div>
        <span class="px-2 py-0.5 text-[10px] bg-slate-950 border border-slate-800 rounded-full text-slate-400" x-text="cat.data.length"></span>
      </button>
    </template>

    <!-- Group 3: Blog Posts / Chronicles -->
    <div class="pt-4 pb-1.5 px-4">
      <span class="text-[10px] text-slate-600 font-semibold uppercase tracking-widest">Blog & Günlük</span>
    </div>

    <template x-for="cat in blogCatalogs" :key="cat.name">
      <button @click="selectCatalog(cat.name)" 
        class="w-full flex items-center justify-between px-4 py-2.5 rounded-xl text-sm font-medium transition-all group"
        :class="activeCatalog === cat.name ? 'bg-gold-500/10 text-gold-300 border border-gold-500/20' : 'text-slate-400 hover:bg-slate-900/50 hover:text-slate-200 border border-transparent'">
        <div class="flex items-center space-x-3">
          <i class="fa-solid fa-feather-pointed text-sm" :class="activeCatalog === cat.name ? 'text-gold-400' : 'text-slate-500'"></i>
          <span x-text="cat.label"></span>
          <span x-show="cat.dirty" class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse" title="Yayınlanmamış değişiklikler var" x-cloak></span>
        </div>
        <span class="px-2 py-0.5 text-[10px] bg-slate-950 border border-slate-800 rounded-full text-slate-400" x-text="cat.data.length"></span>
      </button>
    </template>
  </nav>
</aside>

---
layout: base.njk
pagination:
  data: posts.posts
  size: 1
  alias: post
permalink: "/blog/{{ post.id }}/index.html"
---
  <article class="post-layout">
    
    <!-- Post Header -->
    <header class="post-header reveal">
      <div class="post-meta">
        <span class="blog-category">{{ post.category | default("Philosophy") }}</span>
        <span>&bull;</span>
        <time datetime="{{ post.date | dateIso }}">{{ post.date | postDate }}</time>
      </div>
      <h1 class="post-title">{{ post.title }}</h1>
    </header>

    <!-- Post Hero Image -->
    {% if post.featured_image %}
    <div class="post-hero-image reveal reveal-delay-1">
      <img src="/{{ post.featured_image | imgpath }}" alt="{{ post.title }} hero image">
    </div>
    {% endif %}

    <!-- Post Body -->
    <div class="post-body reveal reveal-delay-2">
      {% for section in post.sections %}
        {% if section.type == "text_block" %}
          {{ section.body | markdown | safe }}
        {% elif section.type == "blockquote" %}
          <blockquote>
            <p>{{ section.quote }}</p>
            {% if section.author %}
              <cite style="display: block; font-family: var(--font-sans); font-size: 0.75rem; letter-spacing: 0.05em; color: var(--c-muted); margin-top: 0.8rem; text-transform: uppercase; font-style: normal;">— {{ section.author }}</cite>
            {% endif %}
          </blockquote>
        {% elif section.type == "image_block" %}
          <figure class="post-image-block">
            <img src="/{{ section.image | imgpath }}" alt="{{ section.alt | default(post.title) }}" loading="lazy">
            {% if section.caption %}
              <figcaption>{{ section.caption }}</figcaption>
            {% endif %}
          </figure>
        {% elif section.type == "video_block" and section.video_url | youtubeEmbed %}
          <figure class="post-video-block" style="margin: 3.5rem auto; max-width: 100%; width: 100%; display: flex; flex-direction: column; gap: 1rem;">
            <div style="position:relative; padding-bottom:56.25%; height:0; overflow:hidden; max-width:100%; border:1px solid var(--c-border); background:#000;">
              <iframe 
                src="{{ section.video_url | youtubeEmbed }}" 
                style="position:absolute; top:0; left:0; width:100%; height:100%; border:0;" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
            {% if section.caption %}
              <figcaption style="font-family: var(--font-serif); font-style: italic; font-size: 0.9rem; color: var(--c-muted); text-align: center; margin-top: 0.2rem;">{{ section.caption }}</figcaption>
            {% endif %}
          </figure>
        {% elif section.type == "subheading" %}
          <h2>{{ section.text }}</h2>
        {% endif %}
      {% endfor %}
    </div>

    <!-- Post Footer -->
    <footer class="post-footer reveal">
      <a href="/blog/index.html" class="btn btn-text" style="font-size:0.75rem; letter-spacing:0.05em; padding-left:0;">← Back to all journal entries</a>
    </footer>

  </article>

  <!-- Suggestions Section -->
  <section class="post-suggestions">
    <div class="container">
      <h2>Other Journal Entries</h2>
      <div class="blog-grid">
        {% set count = 0 %}
        {% for otherPost in posts.posts | reverse %}
          {% if otherPost.id != post.id and count < 3 %}
            {% set count = count + 1 %}
            <article class="blog-card reveal" id="suggested-card-{{ loop.index }}">
              <a href="/blog/{{ otherPost.id }}/index.html" class="blog-card-image">
                <img src="/{{ otherPost.featured_image | imgpath }}" alt="{{ otherPost.title }} card thumbnail" loading="lazy">
              </a>
              <div class="blog-card-meta">
                <span class="blog-category">{{ otherPost.category | default("Craftsmanship") }}</span>
                <span>&bull;</span>
                <time datetime="{{ otherPost.date | dateIso }}">{{ otherPost.date | postDate }}</time>
              </div>
              <a href="/blog/{{ otherPost.id }}/index.html">
                <h3 class="blog-card-title">{{ otherPost.title }}</h3>
              </a>
              <p class="blog-card-summary">{{ otherPost.summary }}</p>
              <a href="/blog/{{ otherPost.id }}/index.html" class="btn btn-text" style="align-self:flex-start; margin-top:auto; font-size:0.75rem; letter-spacing:0.05em; padding-left:0;">Read entry →</a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
